{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "46rem",
			"wideSize": "75rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customDuotone": false,
			"palette": [
				{ "slug": "ink", "color": "#0E1A2B", "name": "Ink" },
				{ "slug": "ink-soft", "color": "#1A2A40", "name": "Ink soft" },
				{ "slug": "chalk", "color": "#F4F6F3", "name": "Chalk" },
				{ "slug": "steel", "color": "#5A6B80", "name": "Steel" },
				{ "slug": "ember", "color": "#F2A900", "name": "Ember" },
				{ "slug": "ember-deep", "color": "#8A5F00", "name": "Ember deep" },
				{ "slug": "win", "color": "#1F9D5B", "name": "Win" },
				{ "slug": "loss", "color": "#D1453B", "name": "Loss" },

				{ "slug": "primary", "color": "#0E1A2B", "name": "Primary" },
				{ "slug": "secondary", "color": "#5A6B80", "name": "Secondary" },
				{ "slug": "success", "color": "#1F9D5B", "name": "Success" },
				{ "slug": "danger", "color": "#D1453B", "name": "Danger" },
				{ "slug": "warning", "color": "#F2A900", "name": "Warning" },
				{ "slug": "info", "color": "#2F7FA8", "name": "Info" },
				{ "slug": "dark", "color": "#0E1A2B", "name": "Dark" },
				{ "slug": "light", "color": "#F4F6F3", "name": "Light" },
				{ "slug": "white", "color": "#FFFFFF", "name": "White" }
			],
			"gradients": [
				{
					"slug": "ember-rise",
					"gradient": "linear-gradient(100deg, #0E1A2B 0%, #1A2A40 70%, #3A2E14 100%)",
					"name": "Ember rise"
				}
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Display",
					"fontFamily": "\"Saira Condensed\", \"Arial Narrow\", system-ui, sans-serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "\"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Data",
					"fontFamily": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small", "fluid": false },
				{ "slug": "normal", "size": "1rem", "name": "Normal", "fluid": false },
				{ "slug": "medium", "size": "1.0625rem", "name": "Medium", "fluid": false },
				{
					"slug": "large",
					"size": "1.5rem",
					"name": "Large",
					"fluid": { "min": "1.35rem", "max": "1.75rem" }
				},
				{
					"slug": "x-large",
					"size": "2.25rem",
					"name": "Extra large",
					"fluid": { "min": "1.9rem", "max": "2.75rem" }
				},
				{
					"slug": "xx-large",
					"size": "3.25rem",
					"name": "Display",
					"fluid": { "min": "2.4rem", "max": "4rem" }
				},
				{
					"slug": "display",
					"size": "3.25rem",
					"name": "Display (parent alias)",
					"fluid": { "min": "2.4rem", "max": "4rem" }
				}
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--chalk)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"padding": { "top": "0", "right": "1.25rem", "bottom": "0", "left": "1.25rem" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--ember-deep)" },
				":hover": { "color": { "text": "var(--wp--preset--color--ink)" } },
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--ember)",
						"style": "solid",
						"width": "2px",
						"offset": "2px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "700",
					"lineHeight": "1.05",
					"letterSpacing": "0.005em",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--ink)",
					"text": "var(--wp--preset--color--chalk)"
				},
				"typography": { "fontWeight": "600" },
				"border": { "radius": "6px" },
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--ink-soft)",
						"text": "var(--wp--preset--color--chalk)"
					}
				}
			}
		},
		"blocks": {
			"core/table": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--ember)",
						"width": "3px",
						"style": "solid"
					}
				},
				"spacing": { "padding": { "left": "1.25rem" } }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--steel)" }
			}
		}
	}
}
